{% assign repo_path = include.repository.repo | default: include.repository %}
{% assign repo_parts = repo_path | split: '/' %}
{% assign owner = repo_parts[0] %}
{% assign name = repo_parts[1] %}
{% if site.data.repositories.github_users contains owner %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ repo_path }}" data-repo="{{ repo_path }}">
    <div class="repo-card-header">
      <i class="fa-solid fa-book-bookmark repo-card-icon"></i>
      <span class="repo-card-name">
        {% if show_owner %}<span class="repo-card-owner">{{ owner }}/</span>{% endif %}{{ name }}
      </span>
    </div>
    {% if include.repository.description %}
      <p class="repo-card-description">{{ include.repository.description }}</p>
    {% endif %}
    <div class="repo-card-meta">
      {% if include.repository.language %}
        <span class="repo-card-lang">
          <span class="repo-card-lang-dot" style="background-color: {{ include.repository.language_color | default: '#8b8b8b' }}"></span>
          {{ include.repository.language }}
        </span>
      {% endif %}
      <span class="repo-card-stat" data-repo-stars hidden>
        <i class="fa-regular fa-star"></i> <span></span>
      </span>
      <span class="repo-card-stat" data-repo-forks hidden>
        <i class="fa-solid fa-code-fork"></i> <span></span>
      </span>
    </div>
  </a>
</div>
